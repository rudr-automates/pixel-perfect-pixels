# AgriVoice — Prototype 01
# Demo mode is the default and needs none of the values below.

VITE_APP_MODE=demo

# Your own Supabase project (public values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only. These must NEVER be prefixed with VITE_ and never reach
# the browser. They belong in Supabase Edge Function secrets.
SARVAM_API_KEY=
GEMINI_API_KEY=
