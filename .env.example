# AgriVoice — Prototype 01
# Demo mode is the default and needs none of the values below.
VITE_APP_MODE=demo

# Your own Supabase project (public values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. NEVER prefix with VITE_; read only inside server routes.
SARVAM_API_KEY=
GEMINI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
